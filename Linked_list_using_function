#include <iostream>
using namespace std;

class node
{
    public:
    int data;
    node * next;
    node(int value)
    {
        data=value;
        next=NULL;
    }
};

node * addfirst(node *head)
{
    int a[]={1,2,3,4};
    int n=4;
    for(int i=0;i<n;i++)
    {
        if(head==NULL)
        {
            head=new node(a[i]);
        }
        else
        {
            node *temp=new node(a[i]);
            temp->next=head;
            head=temp;
        }
    }
    node *t=head;
    
    while(t)
    {
        cout<<t->data;
        t=t->next;
    }
    return head;
}
node *addlast(node *head)
{
    int n=4;
    int a[]={1,2,3,4};
    node *tail=NULL;
    for(int i=0;i<n;i++)
    {
        if(head==NULL)
        {
            head=new node(a[i]);
            tail=head;
        }
        else
        {
            node *temp=new node(a[i]);
            tail->next=temp;
            tail=temp;
        }
    }
    node *t=head;
    
    while(t)
    {
        cout<<t->data;
        t=t->next;
    }
    return head;
}
node *delfirst(node *head)
{
    if(head==NULL)
    {
        cout<<"no elements";
    }
    else
    {
        node *temp=head;
        head=head->next;
        delete temp;
    }
    node *t=head;
    
    while(t)
    {
        cout<<t->data;
        t=t->next;
    }
    return head;
}
node *dellast(node *head)
{
    node *pre=NULL;
    node *curr=head;
    if(head==NULL)
    {
        cout<<"no elements";
    }
    while(curr->next!=NULL)
    {
        pre=curr;
        curr=curr->next;
    }
    delete curr;
    pre->next=NULL;
    return head;
}
